# Runtime
APP_ENV=development
APP_NAME=MeetAI
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=meetai_refresh
COOKIE_DOMAIN=
ALLOW_PUBLIC_SIGNUP=true
# Pipeline execution: auto | inline | celery. Inline runs the whole pipeline
# in the request — required on free hosting where no broker/worker exists.
PIPELINE_MODE=auto
# Comma-separated CORS origins for credentialed requests. Production must list
# the exact frontend origin(s) (e.g. https://meetai.onrender.com); wildcards
# break credentialed refresh-token cookies.
CORS_ORIGINS=*

# MySQL
MYSQL_DATABASE=meetai
MYSQL_USER=meetai
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql+asyncmy://meetai:password@mysql:3306/meetai
DATABASE_URL_SYNC=mysql+pymysql://meetai:password@mysql:3306/meetai

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 (LocalStack locally; set AWS_ENDPOINT_URL blank in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=meetai-recordings
AWS_ENDPOINT_URL=http://localstack:4566
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566

# Groq hosted Whisper (no diarization)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# Deepgram (STT + speaker diarization)
# TRANSCRIPTION_PROVIDER: auto (prefers Deepgram when key set) | groq | deepgram
# SECURITY: the original DEEPGRAM_API_KEY was committed in app/core/config.py
# and is compromised — rotate it in the Deepgram console before using a new one.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
TRANSCRIPTION_PROVIDER=auto

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fast, cheap paid model (~$0.10/M in, $0.60/M out). AVOID `:free` variants —
# OpenRouter throttles them so hard that chat answers can stall for minutes.
OPENROUTER_LLM_MODEL=openai/gpt-5.6-luna
# Hard cap on total output tokens (answer + chain-of-thought)
OPENROUTER_LLM_MAX_TOKENS=2048
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=MeetAI

# Answer generation (grounded Q&A)
# Only the top N evidence chunks go into the LLM prompt, each capped at this
# many characters — keeps the prompt small so the first token arrives fast.
ANSWER_EVIDENCE_LIMIT=5
ANSWER_EVIDENCE_MAX_CHARS=2000

# Multi-turn chat context — the last N Q&A exchanges from the session are sent
# to the LLM (each prior message truncated to this many characters).
CHAT_HISTORY_TURNS=5
CHAT_HISTORY_MAX_CHARS=1500

# Qdrant
# Qdrant Cloud example: https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=meeting_chunks

# Frontend (browser-visible values only)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
